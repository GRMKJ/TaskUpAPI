# TaskUp API environment configuration
# Copy this file to `.env` and adjust values for your environment.

# --- Database connection ---
TASKUP_DATABASE_URL=mysql+pymysql://user:password@localhost:3310/taskup

# --- JWT / security settings ---
TASKUP_JWT_SECRET_KEY=replace-with-long-random-string
TASKUP_JWT_ALGORITHM=HS256
TASKUP_ACCESS_TOKEN_EXPIRES_MINUTES=60
TASKUP_REFRESH_TOKEN_EXPIRES_DAYS=30
TASKUP_PASSWORD_SALT_ROUNDS=12

# --- OAuth providers ---
# Comma-separated list of Google OAuth client IDs allowed to call /auth/google.
# Example: 1234567890-abcdef.apps.googleusercontent.com,0987654321-qwerty.apps.googleusercontent.com
TASKUP_GOOGLE_CLIENT_IDS=[]

# --- Optional overrides ---
# TASKUP_LOG_LEVEL=info
# TASKUP_ENVIRONMENT=local
